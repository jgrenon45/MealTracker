<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MealTracker.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:MealTracker.Pages"
    Title="MealTracker">
    <TabBar>
        <Tab Title="Recipes"
             Icon="recipe.png">
            <ShellContent ContentTemplate="{DataTemplate pages:RecipesPage}" Route="///RecipesPage"/>
        </Tab>
        <Tab Title="Groceries"
             Icon="grocery.png">
            <ShellContent ContentTemplate="{DataTemplate pages:GroceriesPage}" Route="///GroceriesPage"/>
        </Tab>
    </TabBar>

</Shell>
