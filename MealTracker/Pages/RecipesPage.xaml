<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MealTracker.RecipesPage"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             Title="Recipes"
             xmlns:viewmodel="clr-namespace:MealTracker.ViewModels"
             x:DataType="viewmodel:RecipesViewModel">
    <Grid RowDefinitions="Auto, *">
        <Button Text="+ Add Recipe"
                Command="{Binding CreateRecipeCommand}"
                HorizontalOptions="Center"
                VerticalOptions="Start"
                Grid.Row="0"/>
        <CollectionView ItemsSource="{Binding Recipes}"
                        SelectionMode="Single"
                        SelectedItem="{Binding SelectedRecipe, Mode=TwoWay}"
                        Margin="10"
                        WidthRequest="500"
                        Grid.Row="1">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="{x:Type x:String}">
                    <Grid Padding="10" ColumnDefinitions=".75*,.25*">
                        <!-- Recipe Name -->
                        <Label Text="{Binding Name}" VerticalOptions="Center" Grid.Column="0" />

                        <!--Favourite Button-->
                        
                        <!-- 3 Dots Button -->
                        <ImageButton
                            Source="ellipsis.png"
                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:RecipesViewModel}}, Path=ShowOptionsCommand}"
                            CommandParameter="{Binding .}"
                            BackgroundColor="Transparent"
                            HeightRequest="24"
                            WidthRequest="24"
                            VerticalOptions="Center"
                            Grid.Column="1">
                            <ImageButton.Behaviors>
                                <toolkit:IconTintColorBehavior TintColor="{AppThemeBinding Light={DynamicResource Gray950}, Dark={DynamicResource White}}" />
                            </ImageButton.Behaviors>
                        </ImageButton>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>