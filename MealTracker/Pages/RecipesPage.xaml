<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MealTracker.RecipesPage"
             Title="Recipes"
             xmlns:viewmodel="clr-namespace:MealTracker.ViewModels"
             x:DataType="viewmodel:RecipesViewModel">
    <Grid RowDefinitions="Auto, *">
        <Button Text="+ Add Recipe"
                Command="{Binding CreateRecipeCommand}"
                HorizontalOptions="Center"
                VerticalOptions="Start"
                Grid.Row="0"/>
        <CollectionView ItemsSource="{Binding Recipes}"
                        SelectionMode="Single"
                        SelectedItem="{Binding SelectedRecipe, Mode=TwoWay}"
                        Margin="10"
                        Grid.Row="1">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="{x:Type x:String}">
                    <Border Padding="10">
                        <StackLayout>
                            <Label Text="{Binding Name}" FontSize="24" FontAttributes="Bold" />
                            <Label Text="{Binding Description}" FontSize="16" />
                            <Button Text="Edit" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditRecipeCommand}" CommandParameter="{Binding .}" />
                        </StackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>